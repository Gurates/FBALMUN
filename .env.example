# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin Dashboard Password (required to access /admin)
VITE_ADMIN_PASSWORD=

# Official Conference Sender Details (Gonderen e-posta bilgileri)
VITE_SENDER_EMAIL=
VITE_SENDER_NAME=

# Optional: Resend API Key for automatic 1-click email sending (https://resend.com)
VITE_RESEND_API_KEY=

# Optional: SMTP Configuration (if using direct Gmail App Password or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
